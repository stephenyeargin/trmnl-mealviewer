<div class="layout layout--top">
  <div class="flex flex--col h--full w--full gap--small lg:gap--medium">
    <div class="grid grid--cols-{{ weekDays.size }} gap--small lg:gap--medium">
      {% for day in weekDays %}
      <div class="px--2 py--1 bg--gray-6 text-stroke rounded--xsmall flex flex--row gap--distribute">
        <div class="label label--base lg:label--large">{{ day.weekDayName }}</div>
        {% if today.dateKey == day.dateKey %}
        <div class="label label--small lg:label--base label--underline">★</div>
        {% else %}
        <div class="label label--small lg:label--base">{{ day.weekDayDate | date: '%-m/%-d' }}</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    <div class="flex flex--col grow basis--0" style="min-height: 0;">
      {% assign first_meal = true %}
      {% for row in mealRows %}
        {% if blocks_to_display contains row.blockName %}
          {% unless first_meal %}<div class="divider"></div>{% endunless %}
          <div class="grid grid--cols-{{ weekDays.size }} gap--small lg:gap--medium flex-auto" style="min-height: 0; max-height: 50%;">
            {% for day in row.days %}
            <div class="flex flex--col" style="overflow: hidden;">
              <span class="label label--small lg:label--base label--underline">{{ row.blockName }}</span>
              <div class="content">
                {% if day.hasMeals == false %}
                <span class="title title--small">{{ day.statusLabel }}</span>
                {% else %}
                <div class="description description--base lg:description--large">{{ day.text }}</div>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          </div>
          {% assign first_meal = false %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image image-stroke--medium" src="data:image/svg+xml;base64,{{ logo_svg | base64_encode }}" />
  <span class="title">{{ physicalLocation.name }}</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>
