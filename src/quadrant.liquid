<div class="layout layout--row layout--top">
  <div class="flex flex--col w--full gap--small">
    {% assign has_meals = false %}
    {% for meal in todayMeals %}
      {% if blocks_to_display contains meal.blockName %}{% assign has_meals = true %}{% endif %}
    {% endfor %}

    {% if has_meals %}
      {% for meal in todayMeals %}
        {% if blocks_to_display contains meal.blockName %}
        <div class="py--0">
          <span class="label label--small lg:label--base label--underline">{{ meal.blockName }}: </span>
          <span class="description description--base lg:description--large">{{ meal.text }}</span>
        </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="my--5 lg:my--10 text--center">
        <span class="title title--small lg:title--base">No meals today.</span>
      </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <img class="image image-stroke--medium" src="data:image/svg+xml;base64,{{ logo_svg | base64_encode }}" />
  <span class="title">{{ physicalLocation.name }}</span>
</div>
