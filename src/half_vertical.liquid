<div class="layout layout--row layout--top">
  <div class="flex flex--col w--full gap--small">
    {% if todayHasMeals %}
      {% assign first_meal = true %}
      {% for meal in todayMeals %}
        {% if blocks_to_display contains meal.blockName and meal.text != blank %}
        {% unless first_meal %}<div class="divider"></div>{% endunless %}
        <div class="my--2">
          <span class="label label--small lg:label--base label--underline">{{ meal.blockName }}</span>
        </div>
        <div class="richtext">
          <div class="content">{{ meal.text }}</div>
        </div>
        {% assign first_meal = false %}
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="my--5 lg:my--10 text--center">
        <span class="title title--small">No meals today.</span>
      </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <img class="image image-stroke--medium" src="data:image/svg+xml;base64,{{ logo_svg | base64_encode }}" />
  <span class="title">{{ physicalLocation.name }}</span>
  <span class="instance">{{ today.dateFull | date: '%A %-m/%-d' }}</span>
</div>
